<?xml version="1.0"?>
<!--
  MDF x402 v2 facilitator — syd leg (staging, blue/green).

  Joins the tailnet as its own node via Unraid's Tailscale integration (the same
  hook the v1 legs use). No host port is published: nothing is reachable from
  the LAN, and /settle cannot be driven by anyone who is not on the tailnet.

  Apply through the Unraid Docker UI (Docker -> Add Container), not with
  `docker run`, so `my-mdf-facilitator-syd.xml` is generated and
  `net.unraid.docker.managed=dockerman` is set. Pinned by digest.

  Everything this file contains is read by Unraid's dockerMan
  (dynamix.docker.manager/include/Helpers.php, xmlToCommand). There are no
  legacy <Data>, <Networking> or <Environment> blocks: dockerMan ignores them
  on the run path, so a template carrying them silently loses its mounts.

  First start: paste a single-use tailnet auth key (minted with tag:misc-services)
  into TailscaleParams as the authkey flag (two dashes, then authkey=) followed by the single-use key, as the
  tailscale CLI expects. After the node appears, clear that field and restart;
  the node rejoins from the state saved in /app/data/.tailscale_state.
-->
<Container version="2">
  <Name>mdf-facilitator-syd</Name>
  <Repository>bitcryptic/mdf-facilitator@sha256:626252669440b04a1787370eb98ce4733d8a86c55a114d7d6b586b72ac3c5758</Repository>
  <Registry>https://registry.hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/bitcryptic-gw/mdf</Project>
  <Overview>MDF x402 v2 facilitator (staging leg, syd). Tailnet node, no host port, not in the production pool.</Overview>
  <Category/>
  <WebUI>http://[noserve]:8080/health</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/bitcryptic-gw/bitcryptic-blog/main/bc-icon.png</Icon>
  <ExtraParams>--restart=unless-stopped --user 0:0</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>Self-hosted x402 v2 facilitator for MDF (exact on eip155:8453 and eip155:84532). Joins the tailnet as mdf-facilitator-syd; no host port is published. The Unraid Tailscale hook starts as root, then the service drops to uid 1000 before reading the signer key.</Description>
  <TailscaleEnabled>true</TailscaleEnabled>
  <TailscaleHostname>mdf-facilitator-syd</TailscaleHostname>
  <TailscaleStateDir>/app/data/.tailscale_state</TailscaleStateDir>
  <TailscaleUserspaceNetworking>false</TailscaleUserspaceNetworking>
  <TailscaleLANAccess>false</TailscaleLANAccess>
  <TailscaleSSH>false</TailscaleSSH>
  <TailscaleIsExitNode>false</TailscaleIsExitNode>
  <TailscaleExitNodeIP></TailscaleExitNodeIP>
  <TailscaleServe>no</TailscaleServe>
  <TailscaleDParams></TailscaleDParams>
  <TailscaleRoutes></TailscaleRoutes>
  <TailscaleAcceptRoutes>false</TailscaleAcceptRoutes>
  <TailscaleWebUI>http://[noserve]/health</TailscaleWebUI>
  <TailscaleParams/>
  <Config Name="Signer secrets" Target="/run/secrets" Default="/mnt/cache/appdata/mdf-facilitator-syd/secrets" Mode="ro" Description="Directory holding facilitator_signer_key (mode 600, uid 1000). Mounted read-only." Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/mdf-facilitator-syd/secrets</Config>
  <Config Name="Data" Target="/app/data" Default="/mnt/cache/appdata/mdf-facilitator-syd/data" Mode="rw" Description="Persistent data. The Unraid Tailscale hook keeps .tailscale_state here, so the node survives restarts without an auth key." Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/mdf-facilitator-syd/data</Config>
  <Config Name="WebUI Port" Target="PORT" Default="8080" Mode="" Description="Listen port inside the container. Not published to the host." Type="Variable" Display="always" Required="false" Mask="false">8080</Config>
  <Config Name="Base mainnet RPC" Target="BASE_RPC_URL" Default="https://mainnet.base.org" Mode="" Description="JSON-RPC for eip155:8453." Type="Variable" Display="always" Required="false" Mask="false">https://mainnet.base.org</Config>
  <Config Name="Base Sepolia RPC" Target="BASE_SEPOLIA_RPC_URL" Default="https://sepolia.base.org" Mode="" Description="JSON-RPC for eip155:84532." Type="Variable" Display="always" Required="false" Mask="false">https://sepolia.base.org</Config>
  <Config Name="Low-gas threshold (wei)" Target="GAS_THRESHOLD_WEI" Default="500000000000000" Mode="" Description="/health reports degraded below this balance. Default 0.0005 ETH." Type="Variable" Display="advanced" Required="false" Mask="false">500000000000000</Config>
  <Config Name="Balance poll interval (ms)" Target="BALANCE_POLL_MS" Default="300000" Mode="" Description="Background poll for /health balances. Never an RPC call per request." Type="Variable" Display="advanced" Required="false" Mask="false">300000</Config>
  <Config Name="App uid" Target="APP_UID" Default="1000" Mode="" Description="uid the service drops to after the Tailscale hook starts it as root. Must own the signer key file." Type="Variable" Display="advanced" Required="false" Mask="false">1000</Config>
  <Config Name="App gid" Target="APP_GID" Default="1000" Mode="" Description="gid the service drops to after the Tailscale hook starts it as root." Type="Variable" Display="advanced" Required="false" Mask="false">1000</Config>
</Container>
