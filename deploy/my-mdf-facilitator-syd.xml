<?xml version="1.0"?>
<!--
  MDF x402 v2 facilitator — syd leg (staging, blue/green).

  Joins the tailnet as its own node via Unraid's Tailscale integration (the same
  hook the v1 legs use). No host port is published: nothing is reachable from
  the LAN, and /settle cannot be driven by anyone who is not on the tailnet.

  Apply through the Unraid Docker UI (Docker -> Add Container), not with
  `docker run`, so `my-mdf-facilitator-syd.xml` is generated and
  `net.unraid.docker.managed=dockerman` is set. Pinned by digest.

  The Tailscale settings are first-class template elements (TailscaleEnabled,
  TailscaleHostname, TailscaleStateDir, TailscaleUserspaceNetworking), not
  environment variables: the integration reads the elements and turns them into
  the TAILSCALE_* environment itself.

  First start: paste a single-use tailnet auth key (minted with tag:misc-services)
  into TailscaleParams as "authkey=tskey-auth-..." preceded by two dashes, as the
  tailscale CLI expects. After the node appears, clear that field and restart;
  the node rejoins from the state saved in /app/data/.tailscale_state.
-->
<Container version="2">
  <Name>mdf-facilitator-syd</Name>
  <Repository>bitcryptic/mdf-facilitator@sha256:626252669440b04a1787370eb98ce4733d8a86c55a114d7d6b586b72ac3c5758</Repository>
  <Registry>https://registry.hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/bitcryptic-gw/mdf</Project>
  <Overview>MDF x402 v2 facilitator (staging leg, syd). Tailnet node, no host port, not in the production pool.</Overview>
  <Category/>
  <WebUI>http://mdf-facilitator-syd:8080/health</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/bitcryptic-gw/bitcryptic-blog/main/bc-icon.png</Icon>
  <ExtraParams>--restart=unless-stopped --user 0:0</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>Self-hosted x402 v2 facilitator for MDF (exact on eip155:8453 and eip155:84532). Joins the tailnet as mdf-facilitator-syd; no host port is published. The Unraid Tailscale hook starts as root, then the service drops to uid 1000 before reading the signer key.</Description>
  <Networking>
    <Mode>bridge</Mode>
  </Networking>
  <TailscaleEnabled>true</TailscaleEnabled>
  <TailscaleHostname>mdf-facilitator-syd</TailscaleHostname>
  <TailscaleStateDir>/app/data/.tailscale_state</TailscaleStateDir>
  <TailscaleUserspaceNetworking>false</TailscaleUserspaceNetworking>
  <TailscaleLANAccess>false</TailscaleLANAccess>
  <TailscaleSSH>false</TailscaleSSH>
  <TailscaleWebUI>http://mdf-facilitator-syd:8080/health</TailscaleWebUI>
  <TailscaleParams></TailscaleParams>
  <Data>
    <Volume>
      <HostDir>/mnt/cache/appdata/mdf-facilitator-syd/secrets</HostDir>
      <ContainerDir>/run/secrets</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/cache/appdata/mdf-facilitator-syd/data</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Config>
    <Name>WebUI Port</Name>
    <Target>PORT</Target>
    <Default>8080</Default>
    <Mode/>
    <Description>Listen port inside the container. Not published to the host.</Description>
    <Type>Variable</Type>
    <Display>always</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>Base mainnet RPC</Name>
    <Target>BASE_RPC_URL</Target>
    <Default>https://mainnet.base.org</Default>
    <Mode/>
    <Description>JSON-RPC for eip155:8453.</Description>
    <Type>Variable</Type>
    <Display>always</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>Base Sepolia RPC</Name>
    <Target>BASE_SEPOLIA_RPC_URL</Target>
    <Default>https://sepolia.base.org</Default>
    <Mode/>
    <Description>JSON-RPC for eip155:84532.</Description>
    <Type>Variable</Type>
    <Display>always</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>Low-gas threshold (wei)</Name>
    <Target>GAS_THRESHOLD_WEI</Target>
    <Default>500000000000000</Default>
    <Mode/>
    <Description>/health reports degraded below this balance. Default 0.0005 ETH.</Description>
    <Type>Variable</Type>
    <Display>advanced</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>Balance poll interval (ms)</Name>
    <Target>BALANCE_POLL_MS</Target>
    <Default>300000</Default>
    <Mode/>
    <Description>Background poll for /health balances. Never an RPC call per request.</Description>
    <Type>Variable</Type>
    <Display>advanced</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>App uid</Name>
    <Target>APP_UID</Target>
    <Default>1000</Default>
    <Mode/>
    <Description>uid the service drops to after the Tailscale hook starts it as root. Must own the signer key file.</Description>
    <Type>Variable</Type>
    <Display>advanced</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
  <Config>
    <Name>App gid</Name>
    <Target>APP_GID</Target>
    <Default>1000</Default>
    <Mode/>
    <Description>gid the service drops to after the Tailscale hook starts it as root.</Description>
    <Type>Variable</Type>
    <Display>advanced</Display>
    <Required>false</Required>
    <Mask>false</Mask>
  </Config>
</Container>
